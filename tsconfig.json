{
    "compilerOptions": {
        "module": "commonjs",
        "lib": ["es2016", "dom"],
        "noImplicitAny": true,
        "sourceMap": true,
        "strictNullChecks": true,
        "noEmitOnError": true,
        "experimentalDecorators": true,
        "emitDecoratorMetadata": true,
        "skipLibCheck": true
    },
    "exclude": [
      "client/node_modules"
    ]
}